# ============================================================
# DATABASE CONFIGURATION (PostgreSQL for Vercel / Cloud, or SQLite for local)
# ============================================================
# For Vercel production, use a free cloud PostgreSQL URL (e.g., from Neon.tech, Supabase, or Vercel Postgres):
# DATABASE_URL="postgresql://username:password@ep-sample-12345.us-east-2.aws.neon.tech/neondb?sslmode=require"
# For local SQLite development:
DATABASE_URL="file:./dev.db"

# ============================================================
# SERVER SECURITY & SESSIONS
# ============================================================
# Generate a strong random string (e.g. openssl rand -base64 32)
AUTH_SECRET="your-secure-production-random-secret-key-min-32-chars"

# ============================================================
# INITIAL ADMIN CREDENTIALS (USED ON FIRST DB SEED)
# ============================================================
ADMIN_EMAIL="admin@saraswathylab.com"
ADMIN_PASSWORD="YourStrongAdminPassword123!"

# ============================================================
# PUBLIC SEO & SITEMAP CANONICAL URL
# ============================================================
# Set to your live production domain on Vercel:
# e.g., https://saraswathy-lab.vercel.app or https://yourdomain.com
NEXT_PUBLIC_SITE_URL="https://saraswathy-lab.vercel.app"

# ============================================================
# SECURE SMTP EMAIL DELIVERY (For Inquiries & Home Collections)
# ============================================================
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-google-app-password"
EMAIL_FROM="Saraswathy Lab <your-email@gmail.com>"
RESEND_API_KEY="optional-resend-api-key"

# ============================================================
# GOOGLE REVIEWS INTEGRATION (Google Places API)
# ============================================================
GOOGLE_PLACES_API_KEY="your-google-places-api-key"
GOOGLE_PLACE_ID="your-google-place-id"
